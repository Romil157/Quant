# Example environment variables – copy to .env and fill in real values
# Market data provider API keys (if any)
# MARKET_DATA_API_KEY=
# BROKER_API_KEY=
# BROKER_SECRET=

# Database (optional)
# DUCKDB_PATH=data/metadata/quant.duckdb
# SQLITE_PATH=data/metadata/experiments.sqlite

# Security / API Auth (required for non-localhost deployments)
# QUANT_API_KEY=your-secure-api-key-here
# SECRET_KEY=your-secret-key-here

# Logging
# LOG_LEVEL=INFO